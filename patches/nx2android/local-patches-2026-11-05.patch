+// The dma-buf fd of an AHardwareBuffer's native handle: the one whose size is the buffer's. MediaTek's gralloc (Mali-G925, MT6991) hands out three fds, the
+// buffer's second; fd[0] there is a read-only file of size 0 whose mmap fails (ENODEV read, EACCES write), which made every pool a copied one on that GPU.
+// The grallocs seen elsewhere hand out one fd (the buffer's) or put it first.
+static int ahb_buf_fd(const int *fds, int n, uint64_t size) {
+    for (int i = 0; i < n; i++) { struct stat st; if (!fstat(fds[i], &st) && (uint64_t)st.st_size == size) return fds[i]; }
+    return n > 1 ? fds[1] : n == 1 ? fds[0] : -1;
