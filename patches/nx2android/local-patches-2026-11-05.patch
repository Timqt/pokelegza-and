@@ -488,6 +488,27 @@ void vk_crumbs_report(void) {
         shown++; VKLOG("[crumbs] then submission %u pass %d:", c->sub, c->pass);
         for (int k = 0; k < c->n; k++) VKLOG("[crumbs]   shaders %016llx %016llx %016llx", (unsigned long long)c->k[k][0], (unsigned long long)c->k[k][1], (unsigned long long)c->k[k][2]); }
 }
+// The 5 s fence-wait timeout (gfx_vk_core.c wait_fence) lands here: a GPU group the firmware rejected (Mali's GROUP_ERROR_FATAL in the kernel log, which
+// vkQueueSubmit never surfaces as device lost) never signals, and the waiter would hang silently. Name the last pass the GPU finished and the pending
+// passes with their shaders, in full once per fence, then a line a minute. (The ring is read from a foreign thread: worst case it names a torn pass.)
+void vk_crumbs_watchdog(uint64_t fence, VkResult r) {
+    static uint64_t last_f, t0; static int n;
+    if (fence != last_f) { last_f = fence; n = 0; t0 = tick(); }
+    if (n && tick() - t0 < (uint64_t)n * 60000000000ull) return;
+    if (!n) {
+        VKLOG("[watchdog] submission %llu not done 5 s after its wait began (%s %d): a GPU group the firmware rejected never signals", (unsigned long long)fence, r == VK_TIMEOUT ? "timeout" : "result", (int)r);
+        if (g_crumbs > 0 && g_crumb) {
+            uint32_t v = g_crumb[0];
+            VKLOG("[watchdog] GPU marker: submission %u %s %u; host ring %u crumbs", v >> 16, v & 0x8000 ? "dispatch after pass" : "pass", v & 0x7fff, g_cn);
+            int shown = 0;
+            for (unsigned i = g_cn > 512 ? g_cn - 512 : 0; i < g_cn && shown < 10; i++) { crumb_t *c = &g_cring[i % 512];
+                if ((c->sub & 0xffff) < (v >> 16) || ((c->sub & 0xffff) == (v >> 16) && c->pass <= (int)(v & 0x7fff))) continue;
+                shown++; VKLOG("[watchdog] pending: submission %u pass %d:", c->sub, c->pass);
+                for (int k = 0; k < c->n; k++) VKLOG("[watchdog]   shaders %016llx %016llx %016llx", (unsigned long long)c->k[k][0], (unsigned long long)c->k[k][1], (unsigned long long)c->k[k][2]); }
+        } else VKLOG("[watchdog] (DM_VK_CRUMBS=1 at start-up names the pending passes)");
+    } else VKLOG("[watchdog] submission %llu still pending (%.0f s)", (unsigned long long)fence, (tick() - t0) / 1e9);
+    n++;
+}
 void vk_prof_end(void) {
     if (!g_prof_on || !g_prof_t0) return;
     extern uint64_t g_pkg_ns, g_pkg_n; uint64_t tot = tick() - g_prof_t0; g_prof_t0 = 0;
